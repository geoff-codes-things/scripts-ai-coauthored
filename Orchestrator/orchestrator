#!/bin/zsh
# orchestrator
#
# Wrapper script to invoke orchestrator.py via the project venv.
# Run setup.sh first to create the venv.
#
# Usage: ./orchestrator [args...]

SCRIPT_DIR="${0:A:h}"
VENV_PYTHON="$SCRIPT_DIR/.venv/bin/python3"

if [[ ! -x "$VENV_PYTHON" ]]; then
    print "Error: .venv not found. Run setup.sh first." >&2
    exit 1
fi

exec "$VENV_PYTHON" "$SCRIPT_DIR/orchestrator.py" "$@"
